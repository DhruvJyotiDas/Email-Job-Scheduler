NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgresql://ejs:ejs@localhost:5432/ejs
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
JWT_SECRET=change-me
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MIN_DELAY_BETWEEN_SENDS_MS=2000
BULL_BOARD_USER=admin
BULL_BOARD_PASS=admin

# SigNoz / OpenTelemetry — leave blank to disable tracing
OTEL_EXPORTER_OTLP_ENDPOINT=
SIGNOZ_ACCESS_TOKEN=
DAILY_EMAIL_LIMIT_PER_USER=50000
EMAIL_RETENTION_DAYS=90

# AI compose (optional). Calls only happen on explicit button click.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_DAILY_LIMIT_PER_USER=20
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
