generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  scheduled
  sending
  sent
  failed
  delayed_ratelimit
  suppressed
}

model User {
  id         String   @id @default(cuid())
  googleSub  String   @unique @map("google_sub")
  name       String
  email      String
  avatarUrl  String?  @map("avatar_url")
  createdAt  DateTime @default(now()) @map("created_at")
  senders    Sender[]
  campaigns  Campaign[]
  slack      SlackConnection?
  suppressions Suppression[]
  @@map("users")
}

model Sender {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  email           String
  etherealUser    String   @map("ethereal_user")
  etherealPassEnc String   @map("ethereal_pass_enc")
  hourlyLimit     Int      @default(200) @map("hourly_limit")
  isActive        Boolean  @default(true) @map("is_active")
  lastUsedAt      DateTime? @map("last_used_at")
  user            User     @relation(fields: [userId], references: [id])
  emails          Email[]
  @@unique([userId, email])
  @@map("senders")
}

model Campaign {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  subject      String
  bodyTemplate String   @map("body_template")
  startAt      DateTime @map("start_at")
  delayMs      Int      @map("delay_ms")
  hourlyLimit  Int      @map("hourly_limit")
  status       String   @default("scheduled")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id])
  emails       Email[]
  @@map("campaigns")
}

model Email {
  id              String      @id @default(cuid())
  campaignId      String      @map("campaign_id")
  senderId        String?     @map("sender_id")
  recipient       String
  variables       Json?
  subjectRendered String?     @map("subject_rendered")
  bodyRendered    String?     @map("body_rendered")
  step            Int         @default(0)
  status          EmailStatus @default(scheduled)
  scheduledAt     DateTime    @map("scheduled_at")
  sentAt          DateTime?   @map("sent_at")
  lockedAt        DateTime?   @map("locked_at")
  error           String?
  starred         Boolean     @default(false)
  idempotencyKey  String      @unique @map("idempotency_key")
  bullmqJobId     String?     @map("bullmq_job_id")
  previewUrl      String?     @map("preview_url")
  campaign        Campaign    @relation(fields: [campaignId], references: [id])
  sender          Sender?     @relation(fields: [senderId], references: [id])
  @@unique([campaignId, recipient, step])
  @@index([status, scheduledAt])
  @@map("emails")
}

model SlackConnection {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  teamId         String   @map("team_id")
  accessTokenEnc String   @map("access_token_enc")
  channel        String
  connectedAt    DateTime @default(now()) @map("connected_at")
  user           User     @relation(fields: [userId], references: [id])
  @@map("slack_connections")
}

model RateLimitAlert {
  id         String   @id @default(cuid())
  senderId   String   @map("sender_id")
  hourWindow String   @map("hour_window")
  notifiedAt DateTime @default(now()) @map("notified_at")
  @@unique([senderId, hourWindow])
  @@map("rate_limit_alerts")
}

model Suppression {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  email     String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  @@unique([userId, email])
  @@map("suppressions")
}
