{
  "name": "email-job-scheduler",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @ejs/api",
    "dev:worker": "npm run dev -w @ejs/worker",
    "dev:web": "npm run dev -w @ejs/web",
    "build": "npm run build -w @ejs/shared && npm run build -w @ejs/api && npm run build -w @ejs/worker && npm run build -w @ejs/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "seed": "tsx backend/prisma/seed.ts",
    "demo": "tsx backend/prisma/demo.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prisma": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  }
}
